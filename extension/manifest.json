{
  "manifest_version": 3,
  "name": "QNS Web Sites",
  "version": "0.7.0",
  "description": "Open packaged Quilibrium .q websites in Brave.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "http://obscura.q/*",
    "https://obscura.q/*",
    "https://0xenos.qstorage.quilibrium.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {"id": "q_sites", "enabled": true, "path": "redirect_rules.json"}
    ]
  },
  "action": {
    "default_title": "QNS Web Sites",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
