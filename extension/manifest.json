{
  "manifest_version": 3,
  "name": "QNS Web Bridge",
  "version": "0.5.0",
  "description": "Ouvre les sites .q en HTTPS avec des associations locales et un manifeste QStorage signé.",
  "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"},
  "permissions": ["proxy", "storage"],
  "host_permissions": ["http://127.0.0.1:17779/*"],
  "action": {"default_title": "QNS Web Bridge", "default_popup": "popup.html"},
  "background": {"service_worker": "background.js"}
}
