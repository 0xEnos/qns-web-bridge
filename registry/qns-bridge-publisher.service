[Unit]
Description=QNS Web Bridge signed publication API
After=network-online.target

[Service]
Type=simple
User=qnsbridge
Group=qnsbridge
Environment=QNS_REGISTRY_DIR=/srv/qns-bridge/.well-known/qns-bridge
ExecStart=/opt/qns-bridge/.venv/bin/python /opt/qns-bridge/registry/publisher.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
